{
  "swagger": "2.0",
  "info": {
    "title": "EBayManager (read-only)",
    "description": "Read-only access to EBayManager's own data: listings, sales, suggested changes and their outcomes, pricing, and Claude spend. It cannot change eBay or decide a proposal, and it carries no buyer details.",
    "version": "1.0"
  },
  "host": "ebay-autopilot-sandbox-wrpoyt.azurewebsites.net",
  "basePath": "/api/ro",
  "schemes": [
    "https"
  ],
  "consumes": [],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/status": {
      "get": {
        "operationId": "GetStatus",
        "summary": "Get shop status",
        "description": "Live listings, changes waiting, and when the nightly check last ran.",
        "x-ms-visibility": "important",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/listings": {
      "get": {
        "operationId": "ListListings",
        "summary": "List live listings",
        "description": "Every live eBay listing with price, watchers, views and health flags.",
        "x-ms-visibility": "important",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "description": "How many items."
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Listing"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/sales": {
      "get": {
        "operationId": "ListSales",
        "summary": "List sales",
        "description": "Items sold in the period. No buyer details.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 90,
            "description": "How many days back to look (1 to 730).",
            "x-ms-summary": "Days back"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "description": "How many items."
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Sale"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/proposals": {
      "get": {
        "operationId": "ListProposals",
        "summary": "List suggested changes",
        "description": "Changes suggested in the period and what happened to each. Replies and offer answers carry no text.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 90,
            "description": "How many days back to look (1 to 730).",
            "x-ms-summary": "Days back"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "applied",
              "rejected",
              "expired",
              "failed",
              "agreed"
            ],
            "description": "Only this status.",
            "x-ms-summary": "Status"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "description": "How many items."
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Proposal"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/proposals/waiting": {
      "get": {
        "operationId": "ListWaiting",
        "summary": "List changes waiting for a decision",
        "description": "What is waiting for a person, with how long it has waited, how long is left and the link to open. This API cannot decide anything.",
        "x-ms-visibility": "important",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "description": "How many items."
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Waiting"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/pricing": {
      "get": {
        "operationId": "ListPricing",
        "summary": "List the engine's latest prices",
        "description": "The pricing engine's latest price and reasoning for each listing.",
        "x-ms-visibility": "advanced",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "description": "How many items."
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Pricing"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/pricing/{itemId}": {
      "get": {
        "operationId": "GetPricing",
        "summary": "Explain one listing's price",
        "description": "Why the pricing engine suggested its price for one listing.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The eBay item number.",
            "x-ms-summary": "Item number",
            "x-ms-url-encoding": "single"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Pricing"
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/pricing-accuracy": {
      "get": {
        "operationId": "GetPricingAccuracy",
        "summary": "Get pricing accuracy",
        "description": "Each sale beside the engine's last price before it sold.",
        "x-ms-visibility": "advanced",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 730,
            "description": "How many days back to look (1 to 730).",
            "x-ms-summary": "Days back"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AccuracyList"
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/health-flags": {
      "get": {
        "operationId": "ListHealthFlags",
        "summary": "List listing health flags",
        "description": "Listings the nightly check flagged, night by night.",
        "x-ms-visibility": "advanced",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 30,
            "description": "How many days back to look (1 to 730).",
            "x-ms-summary": "Days back"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "description": "How many items."
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/HealthFlag"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/spend": {
      "get": {
        "operationId": "ListSpend",
        "summary": "List Claude spend",
        "description": "What Claude cost per day and job, against the daily budget.",
        "x-ms-visibility": "advanced",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 30,
            "description": "How many days back to look (1 to 730).",
            "x-ms-summary": "Days back"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "description": "How many items."
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Spend"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/digest": {
      "get": {
        "operationId": "GetDigest",
        "summary": "Get the digest",
        "description": "A plain-English summary: what sold, what is waiting, and what was suggested and why. Ready to put in an email.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 7,
            "description": "Days covered (1 to 31).",
            "x-ms-summary": "Days"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Digest"
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        }
      }
    },
    "/export/{name}.csv": {
      "get": {
        "operationId": "GetExport",
        "summary": "Get an export file",
        "description": "One of the nightly CSV files Power BI loads.",
        "x-ms-visibility": "internal",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string",
            "enum": [
              "listings",
              "listings_daily",
              "sales",
              "proposals",
              "price_accuracy",
              "price_decisions",
              "health_flags",
              "claude_spend"
            ],
            "description": "Which file.",
            "x-ms-summary": "File"
          },
          {
            "name": "live",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "1"
            ],
            "description": "Send 1 to build the file now, not use last night's.",
            "x-ms-summary": "Build now"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "string"
            }
          },
          "429": {
            "description": "Too many requests (60 a minute).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found, or the key is wrong."
          }
        },
        "produces": [
          "text/csv"
        ]
      }
    }
  },
  "definitions": {
    "Status": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "description": "sandbox or production."
        },
        "write_mode": {
          "type": "string",
          "description": "approval: approved changes reach eBay. off: everything is a dry run."
        },
        "read_only": {
          "type": "boolean",
          "description": "Always true: this API can't change anything."
        },
        "active_listings": {
          "type": "integer",
          "description": "Live listings."
        },
        "waiting_changes": {
          "type": "integer",
          "description": "Changes waiting for a person."
        },
        "last_nightly_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the nightly check last ran.",
          "x-nullable": true
        },
        "claude_daily_budget_usd": {
          "type": "number",
          "description": "Claude's daily budget in US dollars.",
          "x-nullable": true
        },
        "now": {
          "type": "string",
          "format": "date-time",
          "description": "The server's time.",
          "x-nullable": true
        }
      }
    },
    "Listing": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "description": "eBay item number."
        },
        "title": {
          "type": "string",
          "description": "Listing title."
        },
        "price": {
          "type": "number",
          "description": "Asking price.",
          "x-nullable": true
        },
        "currency": {
          "type": "string",
          "description": "Currency."
        },
        "quantity": {
          "type": "integer",
          "description": "Quantity available."
        },
        "watchers": {
          "type": "integer",
          "description": "Watchers."
        },
        "views_7d": {
          "type": "number",
          "description": "Views in the last 7 days.",
          "x-nullable": true
        },
        "impressions_7d": {
          "type": "number",
          "description": "Times shown in search in the last 7 days.",
          "x-nullable": true
        },
        "start_date": {
          "type": "string",
          "format": "date-time",
          "description": "When it was first listed.",
          "x-nullable": true
        },
        "days_listed": {
          "type": "integer",
          "description": "Days since it was first listed."
        },
        "health_flags": {
          "type": "string",
          "description": "Health flags from the nightly check, separated by spaces: stale, watched_not_selling, low_views, low_click_through."
        },
        "waiting_changes": {
          "type": "integer",
          "description": "Changes waiting for a person on this listing."
        },
        "snapshot_at": {
          "type": "string",
          "format": "date-time",
          "description": "When this was read from eBay.",
          "x-nullable": true
        }
      }
    },
    "Sale": {
      "type": "object",
      "properties": {
        "sale_id": {
          "type": "string",
          "description": "A stable name for the row (not eBay's order number)."
        },
        "sold_at": {
          "type": "string",
          "format": "date-time",
          "description": "When it sold.",
          "x-nullable": true
        },
        "item_id": {
          "type": "string",
          "description": "eBay item number."
        },
        "title": {
          "type": "string",
          "description": "Listing title."
        },
        "quantity": {
          "type": "integer",
          "description": "How many sold."
        },
        "item_price": {
          "type": "number",
          "description": "What one item sold for, without postage.",
          "x-nullable": true
        },
        "line_total": {
          "type": "number",
          "description": "Item price times quantity.",
          "x-nullable": true
        },
        "days_to_sell": {
          "type": "number",
          "description": "Days from first listing to the sale.",
          "x-nullable": true
        },
        "source": {
          "type": "string",
          "description": "ebay, or imported from the Seller Hub report."
        }
      }
    },
    "ProposalDetails": {
      "type": "object",
      "properties": {
        "oldPrice": {
          "type": "number",
          "description": "Price before.",
          "x-nullable": true
        },
        "newPrice": {
          "type": "number",
          "description": "Price proposed.",
          "x-nullable": true
        },
        "title": {
          "type": "string",
          "description": "Proposed title."
        },
        "action": {
          "type": "string",
          "description": "Promotion or offer action."
        },
        "rate": {
          "type": "number",
          "description": "Proposed ad rate, percent.",
          "x-nullable": true
        },
        "currentRate": {
          "type": "number",
          "description": "Current ad rate, percent.",
          "x-nullable": true
        },
        "suggestedRate": {
          "type": "number",
          "description": "eBay's suggested ad rate, percent.",
          "x-nullable": true
        },
        "percent": {
          "type": "number",
          "description": "Percent off offered to watchers.",
          "x-nullable": true
        },
        "price": {
          "type": "number",
          "description": "Listing price.",
          "x-nullable": true
        },
        "offerPrice": {
          "type": "number",
          "description": "Offer price.",
          "x-nullable": true
        },
        "listPrice": {
          "type": "number",
          "description": "Listing price when a Best Offer arrived.",
          "x-nullable": true
        },
        "counterPrice": {
          "type": "number",
          "description": "Counter-offer price.",
          "x-nullable": true
        },
        "watchers": {
          "type": "number",
          "description": "Watchers at the time.",
          "x-nullable": true
        },
        "bestOfferEnabled": {
          "type": "boolean",
          "description": "Whether Best Offer is on."
        }
      }
    },
    "Proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Proposal id."
        },
        "kind": {
          "type": "string",
          "description": "price, revise, create_listing, end_listing, relist, promote, offer_to_watchers, message, best_offer_response or policy."
        },
        "kind_label": {
          "type": "string",
          "description": "The kind in words."
        },
        "item_id": {
          "type": "string",
          "description": "eBay item number, if it's about a listing."
        },
        "item_title": {
          "type": "string",
          "description": "Listing title."
        },
        "status": {
          "type": "string",
          "description": "pending, approved, applying, applied, failed, agreed, rejected or expired."
        },
        "outcome": {
          "type": "string",
          "description": "waiting, approved, rejected or expired."
        },
        "applied": {
          "type": "boolean",
          "description": "True when the change reached eBay."
        },
        "dry_run": {
          "type": "boolean",
          "description": "True when it was made while changes were off."
        },
        "reason": {
          "type": "string",
          "description": "Why it was suggested. Empty for replies and offer answers."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "When it was suggested.",
          "x-nullable": true
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "description": "When a person decided, or it expired.",
          "x-nullable": true
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When it expires if nobody decides.",
          "x-nullable": true
        },
        "hours_to_decide": {
          "type": "number",
          "description": "Hours from suggestion to decision.",
          "x-nullable": true
        },
        "decided_by": {
          "type": "string",
          "description": "Who decided."
        },
        "details": {
          "$ref": "#/definitions/ProposalDetails"
        }
      }
    },
    "Waiting": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Proposal id."
        },
        "kind": {
          "type": "string",
          "description": "The kind of change."
        },
        "kind_label": {
          "type": "string",
          "description": "The kind in words."
        },
        "item_id": {
          "type": "string",
          "description": "eBay item number."
        },
        "item_title": {
          "type": "string",
          "description": "Listing title."
        },
        "status": {
          "type": "string",
          "description": "Always pending."
        },
        "dry_run": {
          "type": "boolean",
          "description": "True when changes are off: it can be agreed but won't reach eBay."
        },
        "reason": {
          "type": "string",
          "description": "Why it was suggested. Empty for replies and offer answers."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "When it was suggested.",
          "x-nullable": true
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When it expires.",
          "x-nullable": true
        },
        "details": {
          "$ref": "#/definitions/ProposalDetails"
        },
        "for": {
          "type": "string",
          "description": "Who it's waiting for: owner, or the name of whoever made the draft."
        },
        "hours_waiting": {
          "type": "number",
          "description": "Hours it has waited.",
          "x-nullable": true
        },
        "hours_left": {
          "type": "number",
          "description": "Hours until it expires.",
          "x-nullable": true
        },
        "open_url": {
          "type": "string",
          "description": "Opens the app, where the person signs in and decides."
        },
        "approve_url": {
          "type": "string",
          "description": "The signed approval page (the real account only; needs a signed-in device). Empty otherwise."
        },
        "reject_url": {
          "type": "string",
          "description": "The signed rejection page (the real account only). Empty otherwise."
        }
      }
    },
    "PriceOption": {
      "type": "object",
      "properties": {
        "price": {
          "type": "number",
          "description": "A price the engine considered.",
          "x-nullable": true
        },
        "days_to_sell": {
          "type": "number",
          "description": "Its estimate of days to sell at that price.",
          "x-nullable": true
        }
      }
    },
    "Pricing": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "description": "eBay item number."
        },
        "title": {
          "type": "string",
          "description": "Listing title."
        },
        "current_price": {
          "type": "number",
          "description": "The listing's price now.",
          "x-nullable": true
