{
  "version": "2.0",
  "functionTimeout": "01:00:00",
  "extensions": {
    "http": { "routePrefix": "" },
    "queues": { "batchSize": 1, "newBatchThreshold": 0, "maxDequeueCount": 3, "visibilityTimeout": "00:01:00", "maxPollingInterval": "00:00:30" }
  },
  "logging": {
    "logLevel": { "default": "Information", "Host.Results": "Error", "Function": "Information" },
    "applicationInsights": { "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" } }
  },
  "extensionBundle": { "id": "Microsoft.Azure.Functions.ExtensionBundle", "version": "[4.*, 5.0.0)" }
}
