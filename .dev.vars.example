# EBayManager secrets, one file per environment. Copy this file to .dev.vars (Sandbox) or .prod.vars (production).
# Both copies are gitignored: never commit them or paste them anywhere.
#
#   node scripts/make-keys.mjs [.prod.vars]   generates SIGNING_KEY, DASHBOARD_KEY, EBAY_DELETION_TOKEN, IMAGEAI_KEY, VAPID_KEY
#   node scripts/people.mjs <env> add ...     writes PEOPLE and SIGNIN_PATH (never edit those two by hand)
#   node scripts/azure-secrets.mjs <env>      uploads every value below to the environment's Key Vault
#
# Anything left empty is treated as unset: the feature that needs it is switched off.

# --- eBay (required) -------------------------------------------------------------------------------------------
# developer.ebay.com -> Application Keys. Use the Sandbox keyset in .dev.vars and the Production keyset in .prod.vars.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
# User Tokens -> "Get a Token from eBay via Your Application" -> your RuName (eBay Redirect URL name), whose
# "auth accepted URL" is https://<your app>/oauth/callback and privacy policy URL https://<your app>/privacy.html
EBAY_RUNAME=

# Optional: a Production keyset used only for public Browse searches (market comparisons) while testing on Sandbox,
# whose own search results are nearly empty. No seller account is involved.
EBAY_COMPS_APP_ID=
EBAY_COMPS_CERT_ID=

# --- Claude (required for listing text, photo checks, triage and reply drafts) ---------------------------------
# console.anthropic.com -> API keys. Spend is capped per day in src/rules.ts (and CLAUDE_DAILY_BUDGET_USD).
ANTHROPIC_API_KEY=

# --- Generated by make-keys.mjs --------------------------------------------------------------------------------
SIGNING_KEY=
DASHBOARD_KEY=
EBAY_DELETION_TOKEN=
VAPID_KEY=
IMAGEAI_KEY=

# --- Written by people.mjs -------------------------------------------------------------------------------------
PEOPLE=
SIGNIN_PATH=

# --- Optional services -----------------------------------------------------------------------------------------
# Sold-price data (docs/sold-price-data.md). Without either, prices come from live listings only.
TRAWL_API_KEY=
COMPSAPI_KEY=
# A second free-plan key for each, used once the first runs out for the month.
TRAWL_API_KEY_2=
COMPSAPI_KEY_2=

# Parcel2Go postage quotes for new listings (docs/parcel2go-api.md).
PARCEL2GO_CLIENT_ID=
PARCEL2GO_CLIENT_SECRET=

# ntfy.sh topic for fallback notifications (pick a long random name; anyone who knows it can read it).
NTFY_TOPIC=

# Bearer token for the /mcp endpoint (Sandbox only; production never serves /mcp).
MCP_TOKEN=

# Microsoft Power Platform (docs/power-platform.md). Generate with: node scripts/make-keys.mjs --power-platform
RO_API_KEY=
INTAKE_API_KEY=
