{
  "name": "ebay-autopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:sandbox": "npm run build:web && wrangler deploy --env sandbox",
    "deploy:production": "npm run build:web && wrangler deploy --env production",
    "db:init:local": "wrangler d1 execute ebay-autopilot-local --local --file=schema.sql",
    "db:init:sandbox": "wrangler d1 execute ebay-autopilot-sandbox --env sandbox --remote --file=schema.sql",
    "db:init:production": "wrangler d1 execute ebay-autopilot-production --env production --remote --file=schema.sql",
    "writes:resume:sandbox": "wrangler d1 execute ebay-autopilot-sandbox --env sandbox --remote --command \"UPDATE settings SET value = '0' WHERE key = 'writes_paused'\"",
    "writes:resume:production": "wrangler d1 execute ebay-autopilot-production --env production --remote --command \"UPDATE settings SET value = '0' WHERE key = 'writes_paused'\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p web",
    "test": "vitest run",
    "build:web": "vite build web",
    "dev:web": "vite web",
    "test:cosmos": "node scripts/test-cosmos.mjs",
    "build:azure": "node scripts/build-azure.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.17.0",
    "@azure/identity": "^4.14.1",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/rokkitt": "^5.3.0",
    "fast-xml-parser": "^5.2.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
