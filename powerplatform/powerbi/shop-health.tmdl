createOrReplace

	expression BaseUrl = "https://ebay-autopilot-sandbox-wrpoyt.azurewebsites.net" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	expression ApiKey = "" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	expression fnExport =
			(name as text) as table =>
			let
				// The key goes in a header, so the data source's credential in Power BI is "Anonymous".
				Raw = Web.Contents(BaseUrl, [RelativePath = "api/ro/export/" & name & ".csv", Headers = [#"X-Api-Key" = ApiKey]]),
				Csv = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Csv, [PromoteAllScalars = true])
			in
				Promoted

	table Calendar
		dataCategory: Time

		column Date
			dataType: dateTime
			isKey
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: Date

		column Year
			dataType: int64
			summarizeBy: none
			sourceColumn: Year

		column Month
			dataType: string
			summarizeBy: none
			sourceColumn: Month

		column 'Week Starting'
			dataType: dateTime
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: Week Starting

		partition Calendar = m
			mode: import
			source =
					let
						Start = #date(2025, 1, 1),
						End = Date.EndOfYear(Date.From(DateTime.LocalNow())),
						Days = List.Dates(Start, Duration.Days(End - Start) + 1, #duration(1, 0, 0, 0)),
						AsTable = Table.FromList(Days, Splitter.SplitByNothing(), {"Date"}),
						Typed = Table.TransformColumnTypes(AsTable, {{"Date", type date}}),
						Year = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
						Month = Table.AddColumn(Year, "Month", each Date.ToText([Date], "yyyy-MM"), type text),
						Week = Table.AddColumn(Month, "Week Starting", each Date.StartOfWeek([Date], Day.Monday), type date)
					in
						Week

	table Listings

		measure 'Active Listings' = COUNTROWS ( Listings )
			formatString: 0

		measure 'Asking Total £' = SUMX ( Listings, Listings[price] * Listings[quantity] )
			formatString: £#,0.00

		column item_id
			dataType: string
			summarizeBy: none
			sourceColumn: item_id

		column title
			dataType: string
			summarizeBy: none
			sourceColumn: title

		column price
			dataType: double
			summarizeBy: none
			sourceColumn: price

		column currency
			dataType: string
			summarizeBy: none
			sourceColumn: currency

		column quantity
			dataType: int64
			summarizeBy: sum
			sourceColumn: quantity

		column watchers
			dataType: int64
			summarizeBy: sum
			sourceColumn: watchers

		column views_7d
			dataType: int64
			summarizeBy: sum
			sourceColumn: views_7d

		column impressions_7d
			dataType: int64
			summarizeBy: sum
			sourceColumn: impressions_7d

		column start_date
			dataType: dateTime
			formatString: General Date
			summarizeBy: none
			sourceColumn: start_date

		column days_listed
			dataType: int64
			summarizeBy: none
			sourceColumn: days_listed

		column health_flags
			dataType: string
			summarizeBy: none
			sourceColumn: health_flags

		column waiting_changes
			dataType: int64
			summarizeBy: sum
			sourceColumn: waiting_changes

		column snapshot_at
			dataType: dateTime
			formatString: General Date
			summarizeBy: none
			sourceColumn: snapshot_at

		partition Listings = m
			mode: import
			source =
					let
						Source = fnExport("listings"),
						Typed = Table.TransformColumnTypes(Source, {{"item_id", type text}, {"title", type text}, {"price", type number}, {"currency", type text}, {"quantity", Int64.Type}, {"watchers", Int64.Type}, {"views_7d", Int64.Type}, {"impressions_7d", Int64.Type}, {"start_date", type datetimezone}, {"days_listed", Int64.Type}, {"health_flags", type text}, {"waiting_changes", Int64.Type}, {"snapshot_at", type datetimezone}}, "en-GB")
					in
						Typed

	table ListingsDaily

		column date
			dataType: dateTime
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: date

		column active_listings
			dataType: int64
			summarizeBy: sum
			sourceColumn: active_listings

		column asking_total
			dataType: double
			summarizeBy: sum
			sourceColumn: asking_total

		column watchers
			dataType: int64
			summarizeBy: sum
			sourceColumn: watchers

		partition ListingsDaily = m
			mode: import
			source =
					let
						Source = fnExport("listings_daily"),
						Typed = Table.TransformColumnTypes(Source, {{"date", type date}, {"active_listings", Int64.Type}, {"asking_total", type number}, {"watchers", Int64.Type}}, "en-GB")
					in
						Typed

	table Sales

		measure 'Revenue £' = SUM ( Sales[line_total] )
			formatString: £#,0.00

		measure 'Items Sold' = SUM ( Sales[quantity] )
			formatString: 0

		measure 'Avg Sale Price £' = AVERAGE ( Sales[item_price] )
			formatString: £#,0.00

		measure 'Avg Days to Sell' = AVERAGE ( Sales[days_to_sell] )
			formatString: 0.0

		measure 'Sell-through' = DIVIDE ( [Items Sold], [Items Sold] + [Active Listings] )
			formatString: 0%

		column sale_id
			dataType: string
			summarizeBy: none
			sourceColumn: sale_id

		column sold_at
			dataType: dateTime
			formatString: General Date
			summarizeBy: none
			sourceColumn: sold_at

		column item_id
			dataType: string
			summarizeBy: none
			sourceColumn: item_id

		column title
			dataType: string
			summarizeBy: none
			sourceColumn: title

		column quantity
			dataType: int64
			summarizeBy: sum
			sourceColumn: quantity

		column item_price
			dataType: double
			summarizeBy: none
			sourceColumn: item_price

		column line_total
			dataType: double
			summarizeBy: sum
			sourceColumn: line_total

		column days_to_sell
			dataType: double
			summarizeBy: none
			sourceColumn: days_to_sell

		column source
			dataType: string
			summarizeBy: none
			sourceColumn: source

		column sold_date
			dataType: dateTime
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: sold_date

		partition Sales = m
			mode: import
			source =
					let
						Source = fnExport("sales"),
						Typed = Table.TransformColumnTypes(Source, {{"sale_id", type text}, {"sold_at", type datetimezone}, {"item_id", type text}, {"title", type text}, {"quantity", Int64.Type}, {"item_price", type number}, {"line_total", type number}, {"days_to_sell", type number}, {"source", type text}}, "en-GB"),
						WithDate = Table.AddColumn(Typed, "sold_date", each Date.From(DateTimeZone.ToUtc([sold_at])), type date)
					in
						WithDate

	table Proposals

		measure Suggested = COUNTROWS ( Proposals )
			formatString: 0

		measure Approved = CALCULATE ( COUNTROWS ( Proposals ), Proposals[outcome] = "approved" )
			formatString: 0

		measure Rejected = CALCULATE ( COUNTROWS ( Proposals ), Proposals[outcome] = "rejected" )
			formatString: 0

		measure Expired = CALCULATE ( COUNTROWS ( Proposals ), Proposals[outcome] = "expired" )
			formatString: 0

		measure Waiting = CALCULATE ( COUNTROWS ( Proposals ), Proposals[outcome] = "waiting" )
			formatString: 0

		measure 'Applied to eBay' = CALCULATE ( COUNTROWS ( Proposals ), Proposals[applied] = TRUE () )
			formatString: 0

		measure 'Approval Rate' = DIVIDE ( [Approved], [Approved] + [Rejected] )
			formatString: 0%

		measure 'Human Override Rate' = DIVIDE ( [Rejected], [Approved] + [Rejected] )
			formatString: 0%

		measure 'Expiry Rate' = DIVIDE ( [Expired], [Suggested] - [Waiting] )
			formatString: 0%

		measure 'Median Hours to Decide' = MEDIAN ( Proposals[hours_to_decide] )
			formatString: 0.0

		column id
			dataType: string
			summarizeBy: none
			sourceColumn: id

		column kind
			dataType: string
			summarizeBy: none
			sourceColumn: kind

		column kind_label
			dataType: string
			summarizeBy: none
			sourceColumn: kind_label

		column item_id
			dataType: string
			summarizeBy: none
			sourceColumn: item_id

		column item_title
			dataType: string
			summarizeBy: none
			sourceColumn: item_title

		column status
			dataType: string
			summarizeBy: none
			sourceColumn: status

		column outcome
			dataType: string
			summarizeBy: none
			sourceColumn: outcome

		column applied
			dataType: boolean
			summarizeBy: none
			sourceColumn: applied

		column dry_run
			dataType: boolean
			summarizeBy: none
			sourceColumn: dry_run

		column created_at
			dataType: dateTime
			formatString: General Date
			summarizeBy: none
			sourceColumn: created_at

		column decided_at
			dataType: dateTime
			formatString: General Date
			summarizeBy: none
			sourceColumn: decided_at

		column expires_at
			dataType: dateTime
			formatString: General Date
			summarizeBy: none
			sourceColumn: expires_at

		column hours_to_decide
			dataType: double
			summarizeBy: none
			sourceColumn: hours_to_decide

		column decided_by
			dataType: string
			summarizeBy: none
			sourceColumn: decided_by

		column old_price
			dataType: double
			summarizeBy: none
			sourceColumn: old_price

		column new_price
			dataType: double
			summarizeBy: none
			sourceColumn: new_price

		column created_date
			dataType: dateTime
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: created_date

		partition Proposals = m
			mode: import
			source =
					let
						Source = fnExport("proposals"),
						Typed = Table.TransformColumnTypes(Source, {{"id", type text}, {"kind", type text}, {"kind_label", type text}, {"item_id", type text}, {"item_title", type text}, {"status", type text}, {"outcome", type text}, {"applied", type logical}, {"dry_run", type logical}, {"created_at", type datetimezone}, {"decided_at", type datetimezone}, {"expires_at", type datetimezone}, {"hours_to_decide", type number}, {"decided_by", type text}, {"old_price", type number}, {"new_price", type number}}, "en-GB"),
						WithDate = Table.AddColumn(Typed, "created_date", each Date.From(DateTimeZone.ToUtc([created_at])), type date)
					in
						WithDate

	table PriceAccuracy

		measure 'Sales Compared' = COUNTROWS ( PriceAccuracy )
			formatString: 0

		measure 'Mean Abs % Error' = AVERAGE ( PriceAccuracy[abs_pct_error] )
			formatString: 0.0%

		measure 'Median Abs % Error' = MEDIAN ( PriceAccuracy[abs_pct_error] )
			formatString: 0.0%

		measure 'Mean Error £' = AVERAGE ( PriceAccuracy[error] )
			formatString: £#,0.00;-£#,0.00

		measure 'Within 10%' = DIVIDE ( CALCULATE ( COUNTROWS ( PriceAccuracy ), PriceAccuracy[abs_pct_error] <= 0.1 ), [Sales Compared] )
			formatString: 0%

		measure 'Sold Above Prediction' = DIVIDE ( CALCULATE ( COUNTROWS ( PriceAccuracy ), PriceAccuracy[error] > 0 ), [Sales Compared] )
			formatString: 0%

		measure 'Priced Before Sale' = DIVIDE ( [Sales Compared], COUNTROWS ( Sales ) )
			formatString: 0%

		column sale_id
			dataType: string
			summarizeBy: none
			sourceColumn: sale_id

		column sold_at
			dataType: dateTime
			formatString: General Date
			summarizeBy: none
			sourceColumn: sold_at

		column item_id
			dataType: string
			summarizeBy: none
			sourceColumn: item_id

		column title
			dataType: string
			summarizeBy: none
			sourceColumn: title

		column group
			dataType: string
			summarizeBy: none
			sourceColumn: group

		column strategy
			dataType: string
			summarizeBy: none
