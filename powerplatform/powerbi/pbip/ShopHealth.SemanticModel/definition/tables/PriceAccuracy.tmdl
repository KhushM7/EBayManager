table PriceAccuracy
	lineageTag: 0c7b7a0c-f9e8-544d-a741-236a2ac79992

	measure 'Sales Compared' = COUNTROWS ( PriceAccuracy )
		formatString: 0
		lineageTag: 577478ad-e12e-51d3-aa81-70dbd9d7c11e

	measure 'Mean Abs % Error' = AVERAGE ( PriceAccuracy[abs_pct_error] )
		formatString: 0.0%
		lineageTag: 14450e05-6624-5763-acb4-7e11cdd7f480

	measure 'Median Abs % Error' = MEDIAN ( PriceAccuracy[abs_pct_error] )
		formatString: 0.0%
		lineageTag: a579c7c1-acee-5713-bf70-546fe5415e53

	measure 'Mean Error £' = AVERAGE ( PriceAccuracy[error] )
		formatString: £#,0.00;-£#,0.00
		lineageTag: 0c87c925-bc51-5fa1-8180-935e240a61c4

	measure 'Within 10%' = DIVIDE ( CALCULATE ( COUNTROWS ( PriceAccuracy ), PriceAccuracy[abs_pct_error] <= 0.1 ), [Sales Compared] )
		formatString: 0%
		lineageTag: 5f952eaa-75b0-59c7-ad4f-ca63ed983878

	measure 'Sold Above Prediction' = DIVIDE ( CALCULATE ( COUNTROWS ( PriceAccuracy ), PriceAccuracy[error] > 0 ), [Sales Compared] )
		formatString: 0%
		lineageTag: 30b668d8-bcee-5ee3-b4ce-43670c89bd35

	measure 'Priced Before Sale' = DIVIDE ( [Sales Compared], COUNTROWS ( Sales ) )
		formatString: 0%
		lineageTag: 77cb5c6c-8848-5a6b-a05d-6058237af1d9

