model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull
	annotation __PBI_TimeIntelligenceEnabled = 0

ref table Calendar
ref table Listings
ref table ListingsDaily
ref table Sales
ref table Proposals
ref table PriceAccuracy
ref table PriceDecisions
ref table HealthFlags
ref table ClaudeSpend
