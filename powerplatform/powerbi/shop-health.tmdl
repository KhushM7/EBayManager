	table HealthFlags

		measure Flags = COUNTROWS ( HealthFlags )
			formatString: 0

		measure 'Flagged Listings' = DISTINCTCOUNT ( HealthFlags[item_id] )
			formatString: 0

		measure 'Flagged Then Changed' =
				VAR flagged = ADDCOLUMNS ( VALUES ( HealthFlags[item_id] ), "@first", CALCULATE ( MIN ( HealthFlags[date] ) ) )
				RETURN
					COUNTROWS (
						FILTER (
							flagged,
							VAR i = HealthFlags[item_id]
							VAR d = [@first]
							RETURN
								NOT ISEMPTY ( FILTER ( ALL ( Proposals ), Proposals[item_id] = i && Proposals[applied] = TRUE () && Proposals[created_date] >= d ) )
						)
					)
			formatString: 0

		measure 'Flagged Then Sold' =
				VAR flagged = ADDCOLUMNS ( VALUES ( HealthFlags[item_id] ), "@first", CALCULATE ( MIN ( HealthFlags[date] ) ) )
				RETURN
					COUNTROWS (
						FILTER (
							flagged,
							VAR i = HealthFlags[item_id]
							VAR d = [@first]
							RETURN
								NOT ISEMPTY ( FILTER ( ALL ( Sales ), Sales[item_id] = i && Sales[sold_date] >= d ) )
						)
					)
			formatString: 0

		measure 'Flagged Sold Rate' = DIVIDE ( [Flagged Then Sold], [Flagged Listings] )
			formatString: 0%

		column date
			dataType: dateTime
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: date

		column item_id
			dataType: string
			summarizeBy: none
			sourceColumn: item_id

		column title
			dataType: string
			summarizeBy: none
			sourceColumn: title

		column flag
			dataType: string
			summarizeBy: none
			sourceColumn: flag

		column detail
			dataType: string
			summarizeBy: none
			sourceColumn: detail

		partition HealthFlags = m
			mode: import
			source =
					let
						Source = fnExport("health_flags"),
						Typed = Table.TransformColumnTypes(Source, {{"date", type date}, {"item_id", type text}, {"title", type text}, {"flag", type text}, {"detail", type text}}, "en-GB")
					in
						Typed

	table ClaudeSpend

		measure 'Claude Cost $' = SUM ( ClaudeSpend[cost_usd] )
			formatString: $#,0.00

		measure 'Claude Calls' = SUM ( ClaudeSpend[calls] )
			formatString: #,0

		measure 'Daily Budget $' = MAXX ( ALL ( ClaudeSpend ), ClaudeSpend[daily_budget_usd] )
			formatString: $#,0.00

		measure 'Avg Daily Cost $' = AVERAGEX ( VALUES ( ClaudeSpend[date] ), [Claude Cost $] )
			formatString: $#,0.000

		measure 'Days Over Budget' = COUNTROWS ( FILTER ( VALUES ( ClaudeSpend[date] ), [Claude Cost $] > [Daily Budget $] ) ) + 0
			formatString: 0

		measure 'Budget Used' = DIVIDE ( [Avg Daily Cost $], [Daily Budget $] )
			formatString: 0%

		measure 'New Listings Submitted' = CALCULATE ( COUNTROWS ( Proposals ), Proposals[kind] = "create_listing" ) + 0
			formatString: 0

		measure 'Cost per New Listing $' = DIVIDE ( CALCULATE ( [Claude Cost $], ClaudeSpend[job] = "listing" ), [New Listings Submitted] )
			formatString: $#,0.000

		column date
			dataType: dateTime
			formatString: dd mmm yyyy
			summarizeBy: none
			sourceColumn: date

		column job
			dataType: string
			summarizeBy: none
			sourceColumn: job

		column model
			dataType: string
			summarizeBy: none
			sourceColumn: model

		column calls
			dataType: int64
			summarizeBy: sum
			sourceColumn: calls

		column input_tokens
			dataType: int64
			summarizeBy: sum
			sourceColumn: input_tokens

		column output_tokens
			dataType: int64
			summarizeBy: sum
			sourceColumn: output_tokens

		column cost_usd
			dataType: double
			summarizeBy: sum
			sourceColumn: cost_usd

		column daily_budget_usd
			dataType: double
			summarizeBy: none
			sourceColumn: daily_budget_usd

		partition ClaudeSpend = m
			mode: import
			source =
					let
						Source = fnExport("claude_spend"),
						Typed = Table.TransformColumnTypes(Source, {{"date", type date}, {"job", type text}, {"model", type text}, {"calls", Int64.Type}, {"input_tokens", Int64.Type}, {"output_tokens", Int64.Type}, {"cost_usd", type number}, {"daily_budget_usd", type number}}, "en-GB")
					in
						Typed

	relationship ListingsDaily_Calendar
		fromColumn: ListingsDaily.date
		toColumn: Calendar.Date

	relationship Sales_Calendar
		fromColumn: Sales.sold_date
		toColumn: Calendar.Date

	relationship Proposals_Calendar
		fromColumn: Proposals.created_date
		toColumn: Calendar.Date

	relationship PriceAccuracy_Calendar
		fromColumn: PriceAccuracy.sold_date
		toColumn: Calendar.Date

	relationship PriceDecisions_Calendar
		fromColumn: PriceDecisions.decided_date
		toColumn: Calendar.Date

	relationship HealthFlags_Calendar
		fromColumn: HealthFlags.date
		toColumn: Calendar.Date

	relationship ClaudeSpend_Calendar
		fromColumn: ClaudeSpend.date
		toColumn: Calendar.Date

