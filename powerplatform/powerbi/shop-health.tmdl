createOrReplace

	expression BaseUrl = "https://ebay-autopilot-sandbox-wrpoyt.azurewebsites.net" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
		lineageTag: f06f5509-efed-5aac-8cd4-4f687868a9b9

	expression ApiKey = "" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
		lineageTag: 92afd541-cb4e-5ff5-b52e-542743898752

	expression fnExport =
			(name as text) as table =>
			let
				// The key goes in a header, so the data source's credential in Power BI is "Anonymous". A wrong or empty key
				// gets the app's blank 404, so an empty one is caught here with a clearer message.
				Key = Text.Trim(ApiKey),
				Checked = if Key = "" then error "Set the ApiKey parameter (Transform data > Edit parameters) to the read-only key, RO_API_KEY." else Key,
				Raw = Web.Contents(Text.TrimEnd(Text.Trim(BaseUrl), "/"), [RelativePath = "api/ro/export/" & name & ".csv", Headers = [#"X-Api-Key" = Checked]]),
				Csv = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Csv, [PromoteAllScalars = true])
			in
				Promoted
		lineageTag: 72e20f07-dcd4-5388-8491-d62f2d66a909

	table Calendar
		dataCategory: Time
		lineageTag: 738627f6-fe05-5f28-827b-1d1318541347

		column Date
			dataType: dateTime
			isKey
			formatString: dd mmm yyyy
			lineageTag: de786f27-28b7-5614-814a-4f5a6250c849
			summarizeBy: none
			sourceColumn: Date

		column Year
			dataType: int64
			lineageTag: 4d614e65-a45c-54df-adea-cb6f8558907a
			summarizeBy: none
			sourceColumn: Year

		column Month
			dataType: string
			lineageTag: 0c802c92-18b3-51c4-a587-48fbac6f7c19
			summarizeBy: none
			sourceColumn: Month

		column 'Week Starting'
			dataType: dateTime
			formatString: dd mmm yyyy
			lineageTag: 118431d3-e548-546a-b064-0de63403aafe
			summarizeBy: none
			sourceColumn: Week Starting

		partition Calendar = m
			mode: import
			source =
					let
						Start = #date(2025, 1, 1),
						End = Date.EndOfYear(Date.From(DateTime.LocalNow())),
						Days = List.Dates(Start, Duration.Days(End - Start) + 1, #duration(1, 0, 0, 0)),
						AsTable = Table.FromList(Days, Splitter.SplitByNothing(), {"Date"}),
						Typed = Table.TransformColumnTypes(AsTable, {{"Date", type date}}),
						Year = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
						Month = Table.AddColumn(Year, "Month", each Date.ToText([Date], "yyyy-MM"), type text),
						Week = Table.AddColumn(Month, "Week Starting", each Date.StartOfWeek([Date], Day.Monday), type date)
					in
						Week

