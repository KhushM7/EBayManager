table Proposals
	lineageTag: c238ce89-d995-5b21-9eea-cf45d6b1f0ee

	measure Suggested = COUNTROWS ( Proposals )
		formatString: 0
		lineageTag: 5cc5f213-ad1a-556e-8ec0-69c222e2cce9

	measure Approved = CALCULATE ( COUNTROWS ( Proposals ), Proposals[outcome] = "approved" )
		formatString: 0
		lineageTag: 19c33348-a32c-51fa-b188-354666beef1c

	measure Rejected = CALCULATE ( COUNTROWS ( Proposals ), Proposals[outcome] = "rejected" )
		formatString: 0
		lineageTag: 0319a167-dfb4-501f-a321-68b58af58fbf

	measure Expired = CALCULATE ( COUNTROWS ( Proposals ), Proposals[outcome] = "expired" )
		formatString: 0
		lineageTag: 6756f2a2-0a40-5bc8-a503-f1f28cf89f33

	measure Waiting = CALCULATE ( COUNTROWS ( Proposals ), Proposals[outcome] = "waiting" )
		formatString: 0
		lineageTag: c441a757-18dc-5985-970c-15a910eae9d0

	measure 'Applied to eBay' = CALCULATE ( COUNTROWS ( Proposals ), Proposals[applied] = TRUE () )
		formatString: 0
		lineageTag: 9c8c55cf-3082-59a9-aa10-e791f0ead528

	measure 'Approval Rate' = DIVIDE ( [Approved], [Approved] + [Rejected] )
		formatString: 0%
		lineageTag: cc8fa8ca-919b-5a2e-8082-f97e8584954b

	measure 'Human Override Rate' = DIVIDE ( [Rejected], [Approved] + [Rejected] )
		formatString: 0%
		lineageTag: bd37ccf5-f13a-5234-8391-fdd68913792e

	measure 'Expiry Rate' = DIVIDE ( [Expired], [Suggested] - [Waiting] )
		formatString: 0%
		lineageTag: 635eae8c-8c26-5aa6-85f2-4d99e1200a28

	measure 'Median Hours to Decide' = MEDIAN ( Proposals[hours_to_decide] )
		formatString: 0.0
		lineageTag: 982107ec-f423-5cdf-a736-efd4bdc479fd

